# ─────────────────────────────────────────────────────────────────────────────
# AI Newsdeck — environment configuration
# Copy to `.env` at the repo root:   cp .env.example .env
# `.env` is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# "development" or "production". In production the backend refuses to start
# with the default JWT_SECRET and never returns password-reset tokens.
APP_ENV=development
# Public URL of the frontend (sent to OpenRouter as HTTP-Referer).
APP_URL=http://localhost:5173

# ── LLM (required) — Claude via OpenRouter ──────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── News search (required) — Tavily ─────────────────────────────────────────
# Get a key at https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
# TAVILY_BASE_URL=https://api.tavily.com

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=168
PASSWORD_RESET_EXPIRES_MINUTES=60

# ── Database ────────────────────────────────────────────────────────────────
# Postgres (recommended) or SQLite. Async drivers are applied automatically.
#   Postgres: postgresql://user:password@localhost:5432/newsdeck
#   SQLite:   sqlite:///./app.db
# If unset, defaults to SQLite at ./app.db.
# (docker-compose overrides this to point at its own Postgres container.)
DATABASE_URL=postgresql://newsdeck:newsdeck@localhost:5432/newsdeck

# Used by docker-compose to create the Postgres container.
POSTGRES_USER=newsdeck
POSTGRES_PASSWORD=newsdeck
POSTGRES_DB=newsdeck

# ── Cache (optional) ────────────────────────────────────────────────────────
# Caches article summaries so repeat URLs don't cost LLM calls.
# If unset or unreachable, the app runs without caching.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=259200

# ── Agent tuning ────────────────────────────────────────────────────────────
MAX_ARTICLES_PER_KEYWORD=8
SEARCH_DEPTH=advanced
NEWS_DAYS_BACK=5
SUMMARIZE_CONCURRENCY=6
# Articles scoring below this relevance (0-10) are dropped.
RELEVANCE_THRESHOLD=4
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=60

# ── Scheduler ───────────────────────────────────────────────────────────────
# Re-runs the agent over all active keywords on an interval.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_MAX_KEYWORDS_PER_RUN=20
SCHEDULER_RUN_ON_STARTUP=false

# ── CORS ────────────────────────────────────────────────────────────────────
# Only needed when the UI is served from a different origin than the API.
# (Vite dev and docker-compose both proxy /api, so same-origin by default.)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── docker-compose ──────────────────────────────────────────────────────────
UI_PORT=8080
